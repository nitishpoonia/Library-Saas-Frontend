# Copy to .env. Values starting with EXPO_PUBLIC_ are built into the app, so never put secrets here.

# Backend base URL including /v1.
# Android emulator talking to a backend on your computer: http://10.0.2.2:4000/v1
# Phone on the same Wi-Fi: http://<your computer's LAN IP>:4000/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/v1
